# ============================================================
# SAVA Marketing Workspace — biến môi trường MẪU (không có giá trị thật)
# Sao chép thành .env khi cần chạy tooling/CLI ở máy local.
# File .env thật KHÔNG được commit (đã có trong .gitignore).
# ============================================================

# URL của Supabase project "sava-marketing-workspace"
# Ví dụ dạng: https://<project-ref>.supabase.co
SUPABASE_URL=

# Anon (public) key của project — dùng cho frontend tĩnh qua config.js.
# Key này public-safe VÌ mọi bảng đều bật RLS; vẫn không nên dán vào nơi công khai ngoài app.
SUPABASE_ANON_KEY=

# Service role key — CHỈ dùng phía server / Edge Function (publish-worker, sync-worker)
# và Supabase CLI khi thao tác quản trị. Key này bypass RLS:
# TUYỆT ĐỐI không đưa vào client, không điền vào config.js, không commit, không chia sẻ qua chat.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# Frontend tĩnh (GitHub Pages) KHÔNG đọc file .env này.
# Frontend đọc cấu hình từ file config.js được tạo từ config.example.js
# (chỉ gồm SUPABASE_URL + SUPABASE_ANON_KEY — xem docs/SETUP.md bước 4).
# ------------------------------------------------------------
